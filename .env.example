PORT=4000
# REQUIRED in production – use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me
JWT_EXPIRES=7d
# SQLite file (created automatically)
DB_PATH=./data/chess.db
UPLOAD_DIR=./uploads
# Comma separated list of allowed origins, or * for all (mobile apps don't need CORS)
CORS_ORIGIN=*
